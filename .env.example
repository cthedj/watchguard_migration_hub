# Application mode
VITE_APP_ENV=development
VITE_AUTH_MODE=demo
VITE_DATA_PROVIDER=local

# Microsoft Entra ID (required when VITE_AUTH_MODE=entra)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_ALLOWED_GROUP_ID=
VITE_ENTRA_REDIRECT_URI=https://migrationhub.dolos.africa/

# Microsoft Graph / SharePoint (required when VITE_DATA_PROVIDER=sharepoint)
VITE_GRAPH_SITE_ID=
VITE_GRAPH_MIGRATIONS_LIST_ID=
VITE_GRAPH_ACCOUNTS_LIST_ID=
VITE_GRAPH_ACTIVITY_LIST_ID=
VITE_GRAPH_TASKS_LIST_ID=

# Space-separated delegated Microsoft Graph scopes.
# Selected-list permissions are preferred for production least privilege.
VITE_GRAPH_SCOPES=https://graph.microsoft.com/User.Read https://graph.microsoft.com/Lists.SelectedOperations.Selected
